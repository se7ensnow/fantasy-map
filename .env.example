# Порты и адреса для docker compose.
# Скопируйте файл в .env (cp .env.example .env), если хотите изменить значения.
FRONTEND_PORT=8080
API_GATEWAY_PORT=8000
USER_SERVICE_PORT=8001
MAP_SERVICE_PORT=8002
USER_DB_PORT=5433
MAP_DB_PORT=5434
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Адреса, которые "зашиваются" во frontend при сборке.
# По умолчанию относительные: NGINX во frontend-контейнере сам проксирует
# /api -> api-gateway и /storage -> minio, поэтому сайт работает по любому адресу
# (localhost, IP мака в Wi-Fi). Абсолютные URL нужны, только если API/хранилище
# вынесены на другой домен.
# ВАЖНО: VITE_API_URL должен включать префикс /api, иначе запросы уйдут на /maps вместо /api/maps.
VITE_API_URL=/api
VITE_STORAGE_URL=/storage/fantasy-maps

# pillow-simd в tile-service собирается под linux/amd64.
# На Apple Silicon оставьте linux/amd64 (эмуляция), на x86_64 можно не задавать.
TILE_SERVICE_PLATFORM=linux/amd64

# Официальные образы MinIO сейчас требуют авторизации, поэтому по умолчанию
# используются публичные зеркала. При наличии доступа к quay.io/minio задайте
# MINIO_IMAGE и MINIO_MC_IMAGE.
MINIO_IMAGE=pgsty/minio:RELEASE.2026-08-04T00-00-00Z
MINIO_MC_IMAGE=pgsty/mc:RELEASE.2026-11-12T00-00-00Z

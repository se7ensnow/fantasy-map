## Шаблон. `make env` копирует его в map-service.env и заменяет @@ПЛЕЙСХОЛДЕРЫ@@
## случайными значениями. Не храните здесь настоящие секреты.
DATABASE_URL=postgresql://postgres:@@MAP_DB_PASSWORD@@@map-db:5432/map_db
REDIS_URL=redis://redis:6379/0
TILE_SERVICE_TASK=tile_service_app.tasks.process_task

S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=@@MINIO_ROOT_PASSWORD@@
S3_BUCKET=fantasy-maps
S3_SECURE=false
